# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment / secrets
.env
.env.*
!.env.example

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/

# LangGraph local API cache
.langgraph_api/

# Local runtime data (PostgreSQL data directory, bind-mounted by compose)
data/

# Runtime logs (written by hlw.core.logging_config, bind-mounted by compose)
logs/

# Local agent workspace (keep the folders, ignore their contents)
workspace/input/*
workspace/output/*
!workspace/input/.gitkeep
!workspace/output/.gitkeep
