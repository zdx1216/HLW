# ============================================================
# HLW 应用镜像构建文件
#
# 构建命令：  docker build -t hlw-api .
# 一般不用单独构建，compose.yaml 里的 api 服务会自动调用它
# ============================================================

# ------------------------------------------------------------
# 第 1 步：选择基础镜像（"毛坯房"）
# ------------------------------------------------------------
# FROM = 从哪个镜像开始构建，每个 Dockerfile 的第一条指令必须是它
# python        → Docker Hub 上 Docker 官方维护的 Python 镜像
# 3.11          → Python 版本号，与 pyproject.toml 的 requires-python >= 3.11 对应
# -slim         → "瘦身版"变体：只带运行 Python 必需的最小系统库（基于 Debian）
#                 约 150MB（完整版约 1GB，alpine 版更小但兼容性坑多）。
#                 本项目依赖都是纯 Python 或预编译包（psycopg[binary]），
#                 不需要 gcc 等编译工具链，所以 slim 完全够用。
# 后续所有 COPY / RUN 都是在这个基础镜像之上叠加新"层"。
FROM python:3.11-slim

# ------------------------------------------------------------
# 第 2 步：把 uv 工具"抄"进当前镜像
# ------------------------------------------------------------
# COPY --from=<来源镜像> <源路径> <目标路径>
# 这是一种"跨镜像复制"：不安装、不下载脚本，直接从
# uv 官方镜像（ghcr.io/astral-sh/uv）里把 /uv、/uvx
# 两个可执行文件复制到本镜像的 /bin/ 目录下。
# 好处：拿到的是官方编译好的二进制，装依赖速度远快于 pip。
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ------------------------------------------------------------
# 第 3 步：配置 Python 与 uv 的环境变量（对后续所有层生效）
# ------------------------------------------------------------
# PYTHONUNBUFFERED=1     关闭 Python 输出缓冲，日志实时打印
#                        （否则容器里 print/logger 可能攒着不输出，出问题难排查）
# PYTHONDONTWRITEBYTECODE=1  不生成 .pyc 字节码文件，减少镜像体积
# UV_COMPILE_BYTECODE=1  uv 改为预编译字节码，容器里 import 更快
# UV_LINK_MODE=copy      uv 安装时用"复制"而不是"硬链接"
#                        （容器构建的层之间硬链接会出问题，copy 最稳）
# UV_PROJECT_ENVIRONMENT=/opt/venv  指定虚拟环境位置
#                        （默认在项目目录下的 .venv，统一放到 /opt/venv 更规范）
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

# ------------------------------------------------------------
# 第 4 步：设置工作目录
# ------------------------------------------------------------
# 相当于 cd /app；目录不存在会自动创建。
# 后续的 COPY / RUN / CMD 中的相对路径都以 /app 为基准。
WORKDIR /app

# ------------------------------------------------------------
# 第 5 步：先只复制依赖清单（利用 Docker 构建缓存！）
# ------------------------------------------------------------
# Docker 的每一层都有缓存：只要 COPY 的文件内容没变、指令没变，
# 就直接复用上次构建的层，不重新执行。
# 依赖清单（pyproject.toml / uv.lock）很少变动，而源码天天改——
# 所以先复制清单装依赖，之后改源码时这一层永远命中缓存，
# 不用每次重新下载所有包。README.md 是因为
# pyproject.toml 里 readme = "README.md"，缺了它 uv sync 会报错。
COPY pyproject.toml uv.lock README.md ./

# ------------------------------------------------------------
# 第 6 步：安装生产环境依赖（此时项目源码还没进来）
# ------------------------------------------------------------
# uv sync --frozen          严格按 uv.lock 安装（lock 文件里的精确版本），
#                           不允许 uv 顺便"升级"依赖，保证构建可复现
# --no-dev                  不安装 dev 依赖组（pytest、ruff、langgraph-cli）
# --no-install-project      只装第三方依赖，暂不安装 hlw 项目本身
#                           （因为 src/ 还没复制进来，装不了；也避免
#                           源码变动触发本层缓存失效重装所有依赖）
RUN uv sync --frozen --no-dev --no-install-project

# ------------------------------------------------------------
# 第 7 步：复制应用源代码
# ------------------------------------------------------------
# 现在才把 src/ 拷进来（含 hlw 包本体）。
# 只有源码变化才会让"之后的层"重建，前面装依赖的缓存层不受影响。
COPY src ./src

# ------------------------------------------------------------
# 第 8 步：安装 hlw 项目本身
# ------------------------------------------------------------
# 这次不带 --no-install-project：把 hlw 以可编辑/正式方式装进虚拟环境，
# 生成命令入口，使 "import hlw" 和模块路径在任何目录下都可用。
RUN uv sync --frozen --no-dev

# ------------------------------------------------------------
# 第 9 步：把虚拟环境的 bin 目录加到 PATH 最前面
# ------------------------------------------------------------
# 这样后面的 CMD 里直接写 uvicorn 就能找到
# /opt/venv/bin/uvicorn，无需写全路径。
ENV PATH="/opt/venv/bin:$PATH"

# ------------------------------------------------------------
# 第 10 步：声明容器监听的端口
# ------------------------------------------------------------
# 纯文档性质，不会真的开放端口；
# 真正的端口映射在 compose.yaml 的 ports: "127.0.0.1:8000:8000"。
EXPOSE 8000

# ------------------------------------------------------------
# 第 11 步：容器启动命令
# ------------------------------------------------------------
# JSON 数组形式（exec 格式），不经过 shell，信号能正确传给 uvicorn。
#   --host 0.0.0.0  监听所有网卡（容器内必须这样，否则宿主机访问不到）
#   --port 8000     与上面 EXPOSE 和 compose.yaml 的映射一致
#
# 注意：故意不加 --workers，只跑单 Worker！
# 因为 AgentService 里的 ThreadExecutionLocks / AgentConcurrencyLimiter
# 都是进程内的 asyncio 锁和信号量，多 worker（多进程）会让它们各自独立、
# 失去"同一 thread_id 串行执行"的保护。要扩容必须先把这些改成跨进程的方案。
CMD ["uvicorn", "hlw.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
